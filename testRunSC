local function safeName(s)
    return (tostring(s):gsub("[^%w_%-%.]", "_"))
end

local function cachedAsset(url, path)
    if not (writefile and isfile and getcustomasset) then return nil end
    if not isfile(path) then
        local ok, data = pcall(function()
            local response = REQUEST({Url=url, Method="GET"})
            if response and (tonumber(response.StatusCode or response.Status or 0) or 0) >= 200
                and (tonumber(response.StatusCode or response.Status or 0) or 0) < 300 then
                return response.Body or response.body
            end
            return nil
        end)
        if ok and type(data) == "string" and #data > 0 then pcall(writefile, path, data) end
    end
    if isfile(path) then
        local ok, asset = pcall(getcustomasset, path)
        if ok then return asset end
    end
    return nil
end

local function githubContents(repo, path)
    local url = "https://api.github.com/repos/" .. GITHUB_OWNER .. "/" .. repo .. "/contents"
    if path and path ~= "" then url = url .. "/" .. path end
    local ok, data = requestJSON("GET", url, nil, {["Accept"]="application/vnd.github+json"})
    if ok and type(data) == "table" then return data end
    return nil
end

local function getPfpAsset(id)
    id = math.clamp(tonumber(id) or 1, 1, 100)
    local file = string.format("%03d.png", id)
    local url = "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. ASSET_REPO .. "/main/pfp/" .. file
    return cachedAsset(url, PFP_CACHE .. "/" .. file)
end

local function getRobloxAvatar(userId, size)
    local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" ..
        enc(userId) .. "&size=" .. (size or "150x150") .. "&format=Png&isCircular=true"
    local ok, data = requestJSON("GET", url)
    if ok and data and data.data and data.data[1] then return data.data[1].imageUrl end
    return ""
end

-- ===== UI helpers =====
local function make(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end
local function corner(obj, radius)
    make("UICorner", {CornerRadius=UDim.new(0, radius or 14)}, obj)
end
local function stroke(obj, color, transparency, thickness)
    return make("UIStroke", {
        Color=color or C.border, Transparency=transparency or 0,
        Thickness=thickness or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
    }, obj)
end
local function pad(obj, l, r, t, b)
    make("UIPadding", {
        PaddingLeft=UDim.new(0,l or 0), PaddingRight=UDim.new(0,r or 0),
        PaddingTop=UDim.new(0,t or 0), PaddingBottom=UDim.new(0,b or 0),
    }, obj)
end
local function label(parent, text, size, color, font, props)
    props = props or {}
    props.BackgroundTransparency = 1
    props.Text = text
    props.TextColor3 = color or C.text
    props.TextSize = math.floor((size or 13) * 1.30 + 0.5)
    props.Font = font or Enum.Font.Gotham
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
    props.BorderSizePixel = 0
    return make("TextLabel", props, parent)
end
local function button(parent, text, size, color, callback)
    local b = make("TextButton", {
        Size=size, BackgroundColor3=color or C.card, BorderSizePixel=0,
        Text=text, TextColor3=C.text, TextSize=17, Font=Enum.Font.GothamMedium,
        AutoButtonColor=false, Active=true,
    }, parent)
    corner(b, 12)
    b.MouseEnter:Connect(function()
        if b.Parent then TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=C.raised}):Play() end
    end)
    b.MouseLeave:Connect(function()
        if b.Parent then TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=color or C.card}):Play() end
    end)
    b.Activated:Connect(function()
        if callback then callback() end
    end)
    return b
end
local function toast(message, isError)
    if not gui or not gui.Parent then return end
    local t = make("TextLabel", {
        AnchorPoint=Vector2.new(0.5,1), Position=UDim2.new(0.5,0,1,-16),
        Size=UDim2.fromOffset(330,34), BackgroundColor3=isError and Color3.fromRGB(65,30,38) or C.raised,
        Text=message, TextColor3=C.text, TextSize=14, Font=Enum.Font.GothamMedium,
        BorderSizePixel=0, ZIndex=100, TextWrapped=true,
    }, main)
    corner(t, 12); stroke(t, isError and C.red or C.border, .25, 1)
    t.BackgroundTransparency=1; t.TextTransparency=1
    TweenService:Create(t,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{
        BackgroundTransparency=0,TextTransparency=0,Position=UDim2.new(.5,0,1,-22)
    }):Play()
    task.delay(2.4,function()
        if t and t.Parent then
            TweenService:Create(t,TweenInfo.new(.16),{TextTransparency=1,BackgroundTransparency=1}):Play()
            task.delay(.2,function() if t then t:Destroy() end end)
        end
    end)
end

