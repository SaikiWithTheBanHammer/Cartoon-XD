local function sendSticker(sticker)
    if not sticker then return end
    local publicUrl = sticker.url or stickerPublicUrl(activeStickerCategory, sticker)
    if not publicUrl or publicUrl == "" then
        StickerStatus.Text = "Sticker URL unavailable"
        return
    end
    local elapsed = os.clock() - lastSentAt
    if elapsed < SLOW_MODE then
        showSlowMode(SLOW_MODE - elapsed)
        return
    end
    lastSentAt = os.clock()
    StickerPanel.Visible = false

    -- The Firebase message contains the PUBLIC GitHub URL, not the local
    -- executor asset path. Other users can therefore download/display it too.
    local message = {
        uid = Auth.uid,
        robloxUserId = profile.robloxUserId,
        username = profile.username,
        displayName = profile.displayName,
        type = "sticker",
        sticker = publicUrl,
        _stickerAsset = sticker.asset,
        timestamp = DateTime.now().UnixTimestampMillis,
    }
    if replyKey then message.replyTo = replyKey end

    local optimisticKey = "local_sticker_" .. tostring(message.timestamp) .. "_" .. tostring(math.random(100000,999999))
    message.key = optimisticKey
    message._optimistic = true
    seen[optimisticKey] = true
    renderMessage(message)
    clearReply()

    local payload = {
        uid=message.uid, robloxUserId=message.robloxUserId, username=message.username,
        displayName=message.displayName, type="sticker", sticker=message.sticker,
        timestamp=message.timestamp,
    }
    if message.replyTo then payload.replyTo = message.replyTo end

    task.spawn(function()
        local ok, result = requestJSON("POST", authURL("/servers/" .. urlEncode(game.JobId) .. "/messages", Auth.idToken), payload)
        if ok then
            local realKey = type(result) == "table" and result.name or nil
            local card = cardByKey[optimisticKey]
            if realKey and card then
                cardByKey[optimisticKey] = nil
                card.Key = realKey
                card.Message.key = realKey
                card.Message._optimistic = nil
                cardByKey[realKey] = card
                seen[realKey] = true
            end
        else
            local card = cardByKey[optimisticKey]
            if card then
                removeCard(card)
                for i=#cards,1,-1 do
                    if cards[i] == card then table.remove(cards,i) break end
                end
            end
            lastSentAt = -math.huge
        end
    end)
end

local function renderStickerGrid()
    clearStickerGrid()
    local items = stickerData[activeStickerCategory] or {}
    local meta = stickerMeta[activeStickerCategory]
    stickerGeneration += 1
    local generation = stickerGeneration

    if #items == 0 then
        StickerStatus.Text = meta and meta.error or "No images found in this category."
        return
    end

    local total = #items
    local ready = 0
    local failed = 0
    StickerStatus.Text = string.format("Loading 0/%d...", total)

    -- Create the entire grid first with empty ImageButtons, then download/cache
    -- images in small batches. The UI stays responsive while assets arrive.
    local buttons = {}
    for i, sticker in ipairs(items) do
        local b = new("ImageButton", {
            BackgroundColor3 = Color3.fromRGB(20,20,23),
            BorderSizePixel = 0,
            Image = "",
            ScaleType = Enum.ScaleType.Fit,
            AutoButtonColor = false,
            ZIndex = 52,
        }, StickerScroll)
        b.LayoutOrder = i
        addCorner(b, 8)
        local loading = new("TextLabel", {
            BackgroundTransparency=1, Size=UDim2.fromScale(1,1),
            Font=Enum.Font.GothamBold, Text="...", TextColor3=Color3.fromRGB(75,75,80),
            TextSize=10, ZIndex=53,
        }, b)
        buttons[i] = b
        b.MouseButton1Click:Connect(function() sendSticker(sticker) end)
    end

    task.spawn(function()
        local nextIndex = 1
        local workers = math.min(3, total)
        local lock = {}

        local function worker()
            while true do
                local index
                if nextIndex <= total then
                    index = nextIndex
                    nextIndex += 1
                else
                    break
                end

                local b = buttons[index]
                local sticker = items[index]
                local asset = nil
                local ok, result = pcall(function()
                    return getStickerAsset(STICKER_REPOS[activeStickerCategory].repo, meta.branch, sticker)
                end)
                if ok then asset = result end

                if generation ~= stickerGeneration or not StickerPanel.Visible then
                    break
                end

                if asset and b and b.Parent then
                    sticker.asset = asset
                    sticker.url = stickerPublicUrl(activeStickerCategory, sticker)
                    b.Image = asset
                    local label = b:FindFirstChildOfClass("TextLabel")
                    if label then label.Visible = false end
                    ready += 1
                else
                    failed += 1
                    local label = b and b:FindFirstChildOfClass("TextLabel")
                    if label then label.Text = "!" end
                end

                StickerStatus.Text = string.format("Loading %d/%d...", ready + failed, total)
                task.wait(0.02)
            end
        end

        local running = {}
        for _=1,workers do
            table.insert(running, task.spawn(worker))
        end

        -- Wait until the workers finish without blocking the UI thread.
        while nextIndex <= total do task.wait(0.05) end
        task.wait(0.15)
        if generation == stickerGeneration then
            if failed > 0 then
                StickerStatus.Text = string.format("Loaded %d/%d  |  %d failed", ready, total, failed)
            else
                StickerStatus.Text = string.format("Loaded %d/%d  |  cached for next run", ready, total)
            end
        end
    end)
end

