-- Firebase anonymous auth
-- -----------------------------------------------------------------------------
local Auth = {
    uid = nil,
    idToken = nil,
    refreshToken = nil,
}

local function firebaseSignIn()
    local ok, data, raw = requestJSON(
        "POST",
        "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. urlEncode(FIREBASE_API_KEY),
        {returnSecureToken = true}
    )

    if not ok or type(data) ~= "table" or not data.localId then
        error("Saiki Rechat: Firebase anonymous sign-in failed: " .. tostring(raw))
    end

    Auth.uid = data.localId
    Auth.idToken = data.idToken
    Auth.refreshToken = data.refreshToken
end

local function refreshAuthToken()
    if not Auth.refreshToken then return false end

    local body = "grant_type=refresh_token&refresh_token=" .. urlEncode(Auth.refreshToken)
    local ok, data = requestJSON(
        "POST",
        "https://securetoken.googleapis.com/v1/token?key=" .. urlEncode(FIREBASE_API_KEY),
        body,
        "application/x-www-form-urlencoded"
    )

    if ok and data and data.id_token then
        Auth.idToken = data.id_token
        Auth.refreshToken = data.refresh_token or Auth.refreshToken
        return true
    end
    return false
end

firebaseSignIn()

