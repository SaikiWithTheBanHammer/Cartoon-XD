            repeat
                loops += 1
                for _, friend in ipairs(pages:GetCurrentPage()) do
                    addDMCandidate(map, friend.Id, friend.Username, friend.DisplayName, "Friend")
                end
                if pages.IsFinished or loops >= 8 then break end
