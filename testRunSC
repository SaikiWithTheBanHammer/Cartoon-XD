}

local function getNameValue(name)
    name = tostring(name or "")
    local value = 0
    for index = 1, #name do
        local cValue = string.byte(name, index) or 0
        local reverseIndex = #name - index + 1
        if #name % 2 == 1 then
            reverseIndex -= 1
        end
        if reverseIndex % 4 >= 2 then
            cValue = -cValue
        end
        value += cValue
    end
    return value
end

local function getDisplayNameColor(displayName)
    local index = (getNameValue(displayName) % #NAME_COLORS) + 1
    return NAME_COLORS[index]
end

