local function renderDMResults()
    clearList(DMResults); clearList(DMServerList); clearList(DMHistoryList)
    if activeDMUser then return end

    local q = string.lower(tostring(DMSearch.Text or "")):gsub("^%s+", ""):gsub("%s+$", "")
    DMSearchClear.Visible = q ~= ""

    if q ~= "" then
        DMHome.Visible=false; DMResults.Visible=true
        local ranked={}
        for _, candidate in pairs(dmCandidates) do
            local score=dmSearchScore(candidate,q)
            if score >= 0 then table.insert(ranked,{candidate=candidate,score=score}) end
        end
        table.sort(ranked,function(a,b)
            if a.score~=b.score then return a.score>b.score end
            local ad=string.lower(a.candidate.DisplayName or "")
            local bd=string.lower(b.candidate.DisplayName or "")
            return ad<bd
        end)
        local exactCount=0
        for _,r in ipairs(ranked) do if r.score>=420 then exactCount+=1 end end
        local shown=0
        local exactLabel=new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,20),Font=Enum.Font.GothamBold,Text="RESULTS",TextColor3=Color3.fromRGB(150,150,156),TextSize=8,TextXAlignment=Enum.TextXAlignment.Left},DMResults)
        local pad=new("UIPadding",{PaddingLeft=UDim.new(0,5),PaddingRight=UDim.new(0,5),PaddingTop=UDim.new(0,2)},exactLabel)
        for _,r in ipairs(ranked) do
            if r.score>=420 and shown<12 then makeDMRow(DMResults,r.candidate,false); shown+=1 end
        end
        local similar=0
        for _,r in ipairs(ranked) do
            if r.score<420 and r.score>=0 and similar<5 then
                if similar==0 then
                    new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,20),Font=Enum.Font.GothamBold,Text="SIMILAR",TextColor3=Color3.fromRGB(112,112,120),TextSize=8,TextXAlignment=Enum.TextXAlignment.Left},DMResults)
                end
                makeDMRow(DMResults,r.candidate,false); similar+=1
            end
        end
        if shown==0 and similar==0 then
            new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,42),Font=Enum.Font.Gotham,Text="No people found\nTry a display name or username",TextColor3=Color3.fromRGB(82,82,88),TextSize=8,TextXAlignment=Enum.TextXAlignment.Center,TextYAlignment=Enum.TextYAlignment.Center},DMResults)
        end
        return
    end

    DMHome.Visible=true; DMResults.Visible=false
    local serverList={}
    for _,candidate in pairs(dmCandidates) do if candidate.Source=="Server" then table.insert(serverList,candidate) end end
    table.sort(serverList,function(a,b) return string.lower(a.DisplayName or "") < string.lower(b.DisplayName or "") end)
    for _,candidate in ipairs(serverList) do makeDMRow(DMServerList,candidate,true) end
    if #serverList==0 then
        new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,34),Font=Enum.Font.Gotham,Text="No one else in this server",TextColor3=Color3.fromRGB(78,78,83),TextSize=8,TextXAlignment=Enum.TextXAlignment.Center,TextYAlignment=Enum.TextYAlignment.Center},DMServerList)
    end
    for _,entry in ipairs(dmHistory) do
        makeDMRow(DMHistoryList,{Id=entry.Id,Username=entry.Username,DisplayName=entry.DisplayName,HasIncoming=entry.HasIncoming==true},true)
    end
    if #dmHistory==0 then
        new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,34),Font=Enum.Font.Gotham,Text="No recent conversations yet",TextColor3=Color3.fromRGB(78,78,83),TextSize=8,TextXAlignment=Enum.TextXAlignment.Center,TextYAlignment=Enum.TextYAlignment.Center},DMHistoryList)
    end
end

