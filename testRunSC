local function addSetting(name,description,defaultValue)
    settingsState[name]=defaultValue
    local row=make("Frame",{Position=UDim2.fromOffset(18,settingsY),Size=UDim2.new(1,-36,0,64),BackgroundColor3=C.panel,BorderSizePixel=0,Visible=false},settingsPage)
    corner(row,14); stroke(row,C.border,.5,1)
    label(row,name,12,C.text,Enum.Font.GothamBold,{Position=UDim2.fromOffset(12,7),Size=UDim2.new(1,-80,0,19)})
    label(row,description,10,C.sub,Enum.Font.Gotham,{
        Position=UDim2.fromOffset(12,27),Size=UDim2.new(1,-80,0,29),TextWrapped=true,
        TextYAlignment=Enum.TextYAlignment.Top,
    })
    local toggle=make("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-12,.5,0),Size=UDim2.fromOffset(42,24),
        BackgroundColor3=defaultValue and C.blue or C.raised,BorderSizePixel=0,Text="",AutoButtonColor=false},row)
    corner(toggle,12)
    local knob=make("Frame",{Position=defaultValue and UDim2.fromOffset(21,3) or UDim2.fromOffset(3,3),
        Size=UDim2.fromOffset(18,18),BackgroundColor3=C.text,BorderSizePixel=0},toggle)
    corner(knob,9)
    toggle.Activated:Connect(function()
        settingsState[name]=not settingsState[name]
        local on=settingsState[name]
        TweenService:Create(toggle,TweenInfo.new(.16),{BackgroundColor3=on and C.blue or C.raised}):Play()
        TweenService:Create(knob,TweenInfo.new(.16,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
            {Position=on and UDim2.fromOffset(21,3) or UDim2.fromOffset(3,3)}):Play()
        if name=="Low-Power Mode" then
            POLL_RATE=on and 4 or 2
            toast(on and "Low-Power Mode enabled" or "Low-Power Mode disabled")
        elseif name=="Sticker Preloading" then
            toast(on and "Stickers will preload when opened" or "Sticker preloading disabled")
        elseif name=="Aura Visibility" then
            toast(on and "Aura visibility enabled (aura module not mounted yet)" or "Aura visibility off")
        elseif name=="Global Chat Updates" then
            toast(on and "Global chat polling enabled when selected" or "Global chat polling disabled")
        else
            toast(name .. (on and " enabled" or " disabled"))
        end
    end)
    settingsY=settingsY+72
    return row
end
