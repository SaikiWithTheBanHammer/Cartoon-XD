local function clearMessages()
    for _,child in ipairs(messageList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    cards={}
    seen={}
end

local function tierStyle(uid)
    -- Tier is intentionally not trusted from message payloads. Until the
    -- follow graph is connected, use the neutral base bubble.
    return C.raised, C.text
end

local function addMessage(key,msg)
    if seen[key] then return end
    if type(msg)~="table" or not msg.txt or not msg.uid then return end
    seen[key]=true
    local own=tostring(msg.uid)==tostring(auth.uid)
    local bubbleColor,textColor=tierStyle(msg.uid)
    local row=make("Frame",{Name="Message_"..safeName(key),Size=UDim2.new(1,0,0,48),
        BackgroundTransparency=1,BorderSizePixel=0,LayoutOrder=#cards+1},messageList)
    local avatar=make("ImageLabel",{Position=UDim2.fromOffset(0,3),Size=UDim2.fromOffset(28,28),
        BackgroundColor3=C.raised,BorderSizePixel=0,Image="",ScaleType=Enum.ScaleType.Crop},row)
    corner(avatar,14)
    local uid=tonumber(msg.uid)
    if uid then
        task.spawn(function()
            local img=getRobloxAvatar(uid,"150x150")
            if img and avatar.Parent then avatar.Image=img end
        end)
    end
    local maxW=math.max(120,messageList.AbsoluteSize.X-72)
    local contentText=tostring(msg.txt)
    local textSize=TextService:GetTextSize(contentText,13,Enum.Font.Gotham,Vector2.new(maxW-24,1000))
    local bubbleW=math.clamp(textSize.X+24,76,maxW)
    local bubbleH=math.max(34,textSize.Y+16)
    row.Size=UDim2.new(1,0,0,bubbleH+23)
    local bubble=make("Frame",{
        Position=own and UDim2.new(1,-bubbleW,0,0) or UDim2.fromOffset(36,0),
        Size=UDim2.fromOffset(bubbleW,bubbleH),BackgroundColor3=own and C.blueTint or bubbleColor,
        BorderSizePixel=0,
    },row)
    corner(bubble,15)
    if own then stroke(bubble,C.blue,.7,1) end
    if not own then
        label(row,tostring(msg.dn or msg.un or "Player"),10,C.blue,Enum.Font.GothamBold,{
            Position=UDim2.fromOffset(37,0),Size=UDim2.new(1,-44,0,13),
        })
        bubble.Position=UDim2.fromOffset(36,15)
        row.Size=UDim2.new(1,0,0,bubbleH+39)
    end
    local body=label(bubble,contentText,13,own and C.text or textColor,Enum.Font.Gotham,{
        Position=UDim2.fromOffset(12,5),Size=UDim2.new(1,-24,1,-10),
        TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Center,
    })
    local time=label(row,os.date("%H:%M",math.floor((tonumber(msg.ts) or os.time()*1000)/1000)),9,C.sub,Enum.Font.Gotham,{
        Position=own and UDim2.new(1,-bubbleW,0,bubbleH+2) or UDim2.fromOffset(38,bubbleH+17),
        Size=UDim2.fromOffset(bubbleW,14),TextXAlignment=own and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,
    })
    table.insert(cards,row)
    if #cards>MAX_CARDS then
        local old=table.remove(cards,1)
        if old and old.Parent then old:Destroy() end
    end
    task.defer(function()
        if messageList and messageList.Parent then
            messageList.CanvasPosition=Vector2.new(0,math.max(0,messageList.CanvasSize.Y.Offset-messageList.AbsoluteSize.Y))
        end
    end)
end

local function currentPath()
    if activeChat=="Global" then return "/chat/global" end
    if activeChat=="DMs" then
        if not activeDMUser then return nil end
        local a,b=tonumber(LocalPlayer.UserId),tonumber(activeDMUser)
        if not a or not b then return nil end
        local low,high=math.min(a,b),math.max(a,b)
        return "/dm/"..tostring(low).."_"..tostring(high)
    end
    if activeChannel=="access" then return "/chat/server/"..enc(game.JobId).."/ch/access" end
    -- Keep the original Saiki Rechat server-message path for compatibility.
    return "/servers/"..enc(game.JobId).."/messages"
end

local function renderHeader()
    if activeChat=="Server" then
        chatTitle.Text=activeChannel=="access" and "Access Lounge" or "Open Lounge"
        chatSubtitle.Text=activeChannel=="access" and "Permission channel • access rules depend on Firebase" or "Server-only • players in this server"
        inputBox.PlaceholderText="Message "..chatTitle.Text.."…"
        updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    elseif activeChat=="Global" then
        chatTitle.Text="Global Chat"; chatSubtitle.Text="Across servers • last 50 messages"
        inputBox.PlaceholderText="Message Global Chat…"; updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    else
        chatTitle.Text=activeDMName and ("@"..activeDMName) or "Direct Messages"
        chatSubtitle.Text=activeDMUser and "Private thread" or "Choose a person from People to start a DM"
        inputBox.PlaceholderText="Write a private message…"; updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    end
end

_G.SaikiHubRenderChat=function()
    renderHeader()
    clearMessages()
    if activeChat=="DMs" and not activeDMUser then
        addMessage("dm_empty",{uid=tostring(auth.uid or LocalPlayer.UserId),dn="Saiki Chat",txt="Open People to select a player and start a DM.",ts=os.time()*1000})
        return
    end
    if activeChat=="Server" and activeChannel=="access" then
        addMessage("access_info",{uid=tostring(auth.uid or LocalPlayer.UserId),dn="Saiki Chat",txt="Access Lounge is reserved for eligible tiers. Firebase rules must enforce access; client-side visibility is not security.",ts=os.time()*1000})
    end
    if refreshMessages then task.spawn(refreshMessages) end
end

local function sendMessage()
    local text=inputBox.Text:gsub("^%s+",""):gsub("%s+$","")
    if text=="" then return end
    if #text>200 then toast("Messages are limited to 200 characters.",true); return end
    if os.clock()-lastSend<COOLDOWN then
        toast("Slow mode: wait "..math.ceil(COOLDOWN-(os.clock()-lastSend)).."s.",true); return
    end
    local path=currentPath()
    if not path then toast("Choose a DM contact first.",true); return end
    if activeChat=="DMs" then
        toast("DM sending will be enabled after the DM contact/index pass.",true)
        return
    end
    if activeChat=="Global" and not settingsState["Global Chat Updates"] then
        toast("Global Chat Updates is disabled in Settings.",true); return
    end
    if activeChannel=="access" then
        toast("Access Lounge sending is disabled until tier rules are connected.",true); return
    end
    lastSend=os.clock()
    local payload={
        uid=tostring(LocalPlayer.UserId), dn=LocalPlayer.DisplayName, un=LocalPlayer.Name,
        pfp=1, txt=text, ts={[".sv"]="timestamp"},
    }
    inputBox.Text=""
    -- Optimistic local render so the UI responds immediately.
    addMessage("local_"..tostring(os.clock()),{
        uid=tostring(LocalPlayer.UserId),dn=LocalPlayer.DisplayName,un=LocalPlayer.Name,
        txt=text,ts=os.time()*1000,
    })
    task.spawn(function()
        local ok,data,raw=dbRequest("POST",path,payload,auth,FIREBASE_DB)
        if ok then
            toast("Message sent")
        else
            toast("Firebase write failed: "..tostring(raw),true)
            warn("[SAIKI CHAT] Send failed: "..tostring(raw))
        end
    end)
end
_G.SaikiHubSend=sendMessage
sendButton.Activated:Connect(sendMessage)
inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and UserInputService:GetFocusedTextBox()==nil then sendMessage() end
end)

refreshMessages=function()
    local path=currentPath()
    if not path or not alive then return end
    local extra='orderBy="$key"&limitToLast='..MAX_CARDS
    local targetAuth = activeChat=="DMs" and dmAuth or auth
    local targetDB = activeChat=="DMs" and DM_FIREBASE_DB or FIREBASE_DB
    if activeChat=="DMs" and not dmAuth.token then firebaseAuth(dmAuth) end
    local ok,data,raw=dbRequest("GET",path,nil,targetAuth,targetDB,extra)
    if not ok then
        if activePage=="Messages" then statusLabel.Text="OFFLINE"; statusLabel.TextColor3=C.red end
        warn("[SAIKI CHAT] Read failed: "..tostring(raw))
        return
    end
    if type(data)~="table" then return end
    local rows={}
    for key,msg in pairs(data) do
        if type(msg)=="table" then table.insert(rows,{key=key,msg=msg}) end
    end
    table.sort(rows,function(a,b) return tostring(a.key)<tostring(b.key) end)
    for _,item in ipairs(rows) do addMessage(item.key,item.msg) end
end

-- ===== Sticker picker (GitHub folders are discovered dynamically) =====
local stickerOverlay
local stickerClosing = false
-- Cache GitHub directory listings for this script session. Reopening the picker
-- or tapping the same category won't repeatedly request the same listing.
local stickerListingCache = {}
local stickerCategoryLoadId = 0
local STICKER_OPEN_SIZE = UDim2.fromOffset(390, 300)
local STICKER_CLOSED_SIZE = UDim2.fromOffset(350, 8)
local function closeStickerPicker()
    local overlay = stickerOverlay
    if not overlay or stickerClosing then return end
    stickerClosing = true
    stickerOverlay = nil
    local tween = TweenService:Create(overlay,
        TweenInfo.new(.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        {Size=STICKER_CLOSED_SIZE, GroupTransparency=1})
    tween:Play()
    tween.Completed:Connect(function()
        if overlay and overlay.Parent then overlay:Destroy() end
        stickerClosing = false
    end)
end
_G.SaikiHubOpenStickers=function()
    if stickerOverlay then closeStickerPicker(); return end
    if stickerClosing then return end
    -- Parent to MainWindow (not Conversation) and use a high ZIndex so the
    -- picker and its category row render above the selector/flyout tabs.
    stickerOverlay=make("CanvasGroup",{
        Name="StickerPicker",AnchorPoint=Vector2.new(1,1),
        Position=UDim2.new(1,-12,1,-58), Size=STICKER_CLOSED_SIZE,
        BackgroundColor3=C.bg, BorderSizePixel=0, ZIndex=80,
        GroupTransparency=1, ClipsDescendants=true,
    },main)
    local overlay = stickerOverlay
    corner(overlay,18); stroke(overlay,C.border,.1,1); pad(overlay,10,10,10,10)
    label(overlay,"STICKERS",11,C.text,Enum.Font.GothamBold,{Size=UDim2.new(1,-40,0,24),ZIndex=81})
    local close=button(overlay,"×",UDim2.fromOffset(28,26),C.card,closeStickerPicker)
    close.Position=UDim2.new(1,-28,0,0); close.ZIndex=83
    local cats=make("ScrollingFrame",{Position=UDim2.fromOffset(0,30),Size=UDim2.new(1,0,0,30),
        BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=0,
        CanvasSize=UDim2.fromOffset(#STICKER_REPOS*88,0),ZIndex=81},overlay)
    make("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder},cats)
    local grid=make("ScrollingFrame",{Position=UDim2.fromOffset(0,66),Size=UDim2.new(1,0,1,-70),
        BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(0,0,0,0),ZIndex=81},overlay)
    local gridLayout=make("UIGridLayout",{CellSize=UDim2.fromOffset(78,78),CellPadding=UDim2.fromOffset(7,7)},grid)
    gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() grid.CanvasSize=UDim2.fromOffset(0,gridLayout.AbsoluteContentSize.Y+8) end)
    local function loadCategory(repo)
        if currentStickerCategory == repo and grid:GetAttribute("LoadedRepo") == repo then
            return -- already displayed; reuse existing tiles
        end
        currentStickerCategory=repo
        stickerCategoryLoadId += 1
        local thisLoadId = stickerCategoryLoadId
        grid:SetAttribute("LoadedRepo", nil)
        for _,child in ipairs(grid:GetChildren()) do if child:IsA("ImageButton") then child:Destroy() end end
        task.spawn(function()
            local contents = stickerListingCache[repo]
            if type(contents) ~= "table" then
                contents=githubContents(repo,"")
                if type(contents)=="table" then stickerListingCache[repo]=contents end
            end
            if thisLoadId ~= stickerCategoryLoadId or not overlay.Parent then return end
            if type(contents)~="table" then toast("Could not load sticker list.",true); return end
            grid:SetAttribute("LoadedRepo", repo)
            local count=0
            for _,item in ipairs(contents) do
                local lowerName=item.name:lower()
                local isImage=lowerName:match("%.png$") or lowerName:match("%.jpg$") or lowerName:match("%.jpeg$") or lowerName:match("%.webp$") or lowerName:match("%.gif$")
                if item.type=="file" and isImage then
                    count=count+1
                    if count>80 then break end
                    local raw=item.download_url or ("https://raw.githubusercontent.com/"..GITHUB_OWNER.."/"..repo.."/main/"..enc(item.name))
                    local localPath=STICKER_CACHE.."/"..safeName(repo).."_"..safeName(item.name)
                    -- cachedAsset checks that the local file still exists and uses it
                    -- when available; only missing files are fetched again.
                    local asset=cachedAsset(raw,localPath)
                    if thisLoadId ~= stickerCategoryLoadId or not overlay.Parent then return end
                    local tile=make("ImageButton",{Size=UDim2.fromOffset(78,78),BackgroundColor3=C.card,
                        BorderSizePixel=0,Image=asset or raw,ScaleType=Enum.ScaleType.Fit,AutoButtonColor=false,ZIndex=82},grid)
                    corner(tile,12); stroke(tile,C.border,.5,1)
                    tile.Activated:Connect(function()
                        -- Keep the existing selection/send integration status honest,
                        -- but dismiss the picker smoothly after a sticker is chosen.
                        closeStickerPicker()
                        toast("Sticker sending is not connected yet.",true)
                    end)
                    if count%3==0 then task.wait(.03) end
                end
            end
        end)
    end
    for _,def in ipairs(STICKER_REPOS) do
        local b=button(cats,def.name:gsub("%-XD",""),UDim2.fromOffset(84,27),C.card,function() loadCategory(def.repo) end)
        b.TextSize=12; b.ZIndex=82
    end
    loadCategory(currentStickerCategory)
    TweenService:Create(overlay,TweenInfo.new(.24,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
        {Size=STICKER_OPEN_SIZE,GroupTransparency=0}):Play()
end

-- ===== Drag the dock + window as one combined interface =====
local function beginDrag(input)
    if anchored then return end
    dragging=true; dragStart=input.Position; startPos=combined.Position
end
local function endDrag() dragging=false end
header.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then beginDrag(input) end
end)
dock.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then beginDrag(input) end
end)
table.insert(connections,UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
        local delta=input.Position-dragStart
        combined.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end))
table.insert(connections,UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then endDrag() end
end))

-- Responsive scaling: preserve the combined shape on smaller screens.
local function fitToViewport()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local viewport=camera.ViewportSize
    local sx=(viewport.X-24)/(MAIN_W+DOCK_W+GAP)
    local sy=(viewport.Y-24)/MAIN_H
    local scale=math.clamp(math.min(sx,sy,1),.55,1)
    local scaler=combined:FindFirstChildOfClass("UIScale") or make("UIScale",{Scale=scale},combined)
    scaler.Scale=scale
end
if workspace.CurrentCamera then
    table.insert(connections,workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitToViewport))
end
fitToViewport()

