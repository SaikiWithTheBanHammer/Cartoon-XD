local function encodePath(path)
    local out = {}
    for part in tostring(path):gmatch("[^/]+") do
        table.insert(out, HttpService:UrlEncode(part))
    end
    return table.concat(out, "/")
end

local function isImagePath(path)
    local lower = tostring(path):lower()
    -- Roblox custom assets are most reliable with these formats.
    return lower:match("%.png$") or lower:match("%.jpg$") or lower:match("%.jpeg$")
end

local function stickerManifestPath(repoName)
    return STICKER_CACHE_FOLDER .. "/_manifest_" .. tostring(repoName):gsub("[^%w%-]", "_") .. ".json"
end

local function stickerCacheName(repoName, path)
    local safe = (tostring(repoName) .. "__" .. tostring(path)):gsub("[^%w%._%-]", "_")
    return STICKER_CACHE_FOLDER .. "/" .. safe
end

local function httpGetBody(url, headers)
    if not REQUEST then return false, nil, "no request function" end
    local ok, result = pcall(REQUEST, {
        Url = url,
        Method = "GET",
        Headers = headers or {},
    })
    if not ok or not result then
        return false, nil, tostring(result)
    end
    local status = tonumber(result.StatusCode or result.Status or 0) or 0
    local body = result.Body or result.body
    if status >= 200 and status < 300 and type(body) == "string" and #body > 0 then
        return true, body, status
    end
    return false, body, status
end

local function ensureStickerFolders()
    if not makefolder then return end
    if isfolder then
        if not isfolder(CACHE_FOLDER) then pcall(makefolder, CACHE_FOLDER) end
        if not isfolder(STICKER_CACHE_FOLDER) then pcall(makefolder, STICKER_CACHE_FOLDER) end
    else
        pcall(makefolder, CACHE_FOLDER)
        pcall(makefolder, STICKER_CACHE_FOLDER)
    end
end
ensureStickerFolders()

local function saveStickerManifest(repoName, branch, items)
    if not (writefile and HttpService) then return end
    local path = stickerManifestPath(repoName)
    pcall(writefile, path, HttpService:JSONEncode({branch = branch, items = items, savedAt = os.time()}))
end

local function readStickerManifest(repoName)
    if not (readfile and isfile and isfile(stickerManifestPath(repoName))) then return nil end
    local ok, raw = pcall(readfile, stickerManifestPath(repoName))
    if not ok or type(raw) ~= "string" then return nil end
    local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or type(decoded) ~= "table" or type(decoded.items) ~= "table" then return nil end
    return decoded
end

local function fetchStickerRepo(repoName)
    -- Use the GitHub repo endpoint first so the script works if the repository
    -- uses master or another default branch instead of main.
    local repoApi = "https://api.github.com/repos/" .. GITHUB_OWNER .. "/" .. repoName
    local okRepo, repoBody = httpGetBody(repoApi, { ["Accept"] = "application/vnd.github+json", ["User-Agent"] = "Saiki-Rechat" })
    if not okRepo then
        local cached = readStickerManifest(repoName)
        if cached then return cached.items, cached.branch or "main", true end
        return {}, "main", false
    end

    local okDecoded, repoInfo = pcall(HttpService.JSONDecode, HttpService, repoBody)
    if not okDecoded or type(repoInfo) ~= "table" then return {}, "main", false end
    local branch = tostring(repoInfo.default_branch or "main")

    local treeUrl = "https://api.github.com/repos/" .. GITHUB_OWNER .. "/" .. repoName .. "/git/trees/" .. HttpService:UrlEncode(branch) .. "?recursive=1"
    local okTree, treeBody = httpGetBody(treeUrl, { ["Accept"] = "application/vnd.github+json", ["User-Agent"] = "Saiki-Rechat" })
    if not okTree then
        local cached = readStickerManifest(repoName)
        if cached then return cached.items, cached.branch or branch, true end
        return {}, branch, false
    end

    local okTreeDecoded, tree = pcall(HttpService.JSONDecode, HttpService, treeBody)
    if not okTreeDecoded or type(tree) ~= "table" or type(tree.tree) ~= "table" then
        local cached = readStickerManifest(repoName)
        if cached then return cached.items, cached.branch or branch, true end
        return {}, branch, false
    end

    local result = {}
    for _, item in ipairs(tree.tree) do
        if item.type == "blob" and isImagePath(item.path) then
            table.insert(result, {
                path = tostring(item.path),
                sha = tostring(item.sha or ""),
                size = tonumber(item.size or 0) or 0,
            })
        end
    end
    table.sort(result, function(a, b) return a.path:lower() < b.path:lower() end)
    saveStickerManifest(repoName, branch, result)
    return result, branch, true
end

local function getStickerAsset(repoName, branch, item)
    if not (writefile and isfile and getcustomasset) then
        return nil, "executor has no writefile/getcustomasset"
    end

    local localPath = stickerCacheName(repoName, item.path)
    if isfile(localPath) then
        local ok, asset = pcall(getcustomasset, localPath)
        if ok and asset then return asset, "cache" end
    end

    local rawUrl = "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. repoName .. "/" .. encodePath(branch .. "/" .. item.path)
    local ok, body, status = httpGetBody(rawUrl, { ["User-Agent"] = "Saiki-Rechat" })
    if not ok or type(body) ~= "string" then
        return nil, "download " .. tostring(status)
    end

    local wrote = pcall(writefile, localPath, body)
    if not wrote or not isfile(localPath) then
        return nil, "write failed"
    end

    local okAsset, asset = pcall(getcustomasset, localPath)
    if okAsset and asset then return asset, "download" end
    return nil, "getcustomasset failed"
end

local function stickerPublicUrl(categoryIndex, sticker)
    if not sticker then return nil end
    if type(sticker.url) == "string" and sticker.url ~= "" then return sticker.url end
    local cat = STICKER_REPOS[categoryIndex]
    local meta = stickerMeta[categoryIndex]
    if not cat or not meta or not meta.branch or not sticker.path then return nil end
    return "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. cat.repo .. "/" .. encodePath(meta.branch .. "/" .. sticker.path)
end

-- Messages contain a public raw GitHub URL so every client can resolve the
-- same sticker. Each client then downloads that URL once and converts it to a
-- local getcustomasset() URL for ImageLabel.Image.
local function cacheRemoteSticker(url)
    if type(url) ~= "string" or url == "" then return nil end
    if not (writefile and isfile and getcustomasset) then return url end

    local safe = url:gsub("^https?://", ""):gsub("[^%w%._%-]", "_")
    local path = STICKER_CACHE_FOLDER .. "/message__" .. safe
    if not isfile(path) then
        local ok, body = httpGetBody(url, { ["User-Agent"] = "Saiki-Rechat" })
        if not ok or type(body) ~= "string" or #body == 0 then return nil end
        local wrote = pcall(writefile, path, body)
        if not wrote or not isfile(path) then return nil end
    end

    local okAsset, asset = pcall(getcustomasset, path)
    if okAsset and asset then return asset end
    return nil
end

