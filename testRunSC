        if messageList and messageList.Parent then
            messageList.CanvasPosition=Vector2.new(0,math.max(0,messageList.CanvasSize.Y.Offset-messageList.AbsoluteSize.Y))
        end
    end)
end

local function currentPath()
    if activeChat=="Global" then return "/chat/global" end
    if activeChat=="DMs" then
        if not activeDMUser then return nil end
        local a,b=tonumber(auth.uid) or tonumber(LocalPlayer.UserId),tonumber(activeDMUser)
        if not a or not b then return nil end
        local low,high=math.min(a,b),math.max(a,b)
        return "/dm/"..tostring(low).."_"..tostring(high)
    end
    if activeChannel=="access" then return "/chat/server/"..enc(game.JobId).."/ch/access" end
    -- Keep the original Saiki Rechat server-message path for compatibility.
    return "/servers/"..enc(game.JobId).."/messages"
end

local function renderHeader()
    if activeChat=="Server" then
        chatTitle.Text=activeChannel=="access" and "Access Lounge" or "Open Lounge"
        chatSubtitle.Text=activeChannel=="access" and "Permission channel • access rules depend on Firebase" or "Server-only • players in this server"
        inputBox.PlaceholderText="Message "..chatTitle.Text.."…"
        channelGroup.Visible=true
        updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    elseif activeChat=="Global" then
        chatTitle.Text="Global Chat"; chatSubtitle.Text="Across servers • last 50 messages"
        inputBox.PlaceholderText="Message Global Chat…"; channelGroup.Visible=false; updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    else
        chatTitle.Text=activeDMName and ("@"..activeDMName) or "Direct Messages"
        chatSubtitle.Text=activeDMUser and "Private thread" or "Choose a person from People to start a DM"
        inputBox.PlaceholderText="Write a private message…"; channelGroup.Visible=false; updateSelectorPanels()
        stickerButton.Visible=true; sendButton.Visible=true; inputBox.Visible=true
    end
end

_G.SaikiHubRenderChat=function()
    renderHeader()
    clearMessages()
    if activeChat=="DMs" and not activeDMUser then
        addMessage("dm_empty",{uid=tostring(auth.uid or LocalPlayer.UserId),dn="Saiki Chat",txt="Open People to select a player and start a DM.",ts=os.time()*1000})
        return
    end
    if activeChat=="Server" and activeChannel=="access" then
        addMessage("access_info",{uid=tostring(auth.uid or LocalPlayer.UserId),dn="Saiki Chat",txt="Access Lounge is reserved for eligible tiers. Firebase rules must enforce access; client-side visibility is not security.",ts=os.time()*1000})
    end
    if refreshMessages then task.spawn(refreshMessages) end
end

local function sendMessage()
    local text=inputBox.Text:gsub("^%s+",""):gsub("%s+$","")
    if text=="" then return end
    if #text>200 then toast("Messages are limited to 200 characters.",true); return end
    if os.clock()-lastSend<COOLDOWN then
        toast("Slow mode: wait "..math.ceil(COOLDOWN-(os.clock()-lastSend)).."s.",true); return
    end
    local path=currentPath()
    if not path then toast("Choose a DM contact first.",true); return end
    if activeChat=="DMs" then
        toast("DM sending will be enabled after the DM contact/index pass.",true)
        return
    end
    if activeChat=="Global" and not settingsState["Global Chat Updates"] then
        toast("Global Chat Updates is disabled in Settings.",true); return
    end
    if activeChannel=="access" then
        toast("Access Lounge sending is disabled until tier rules are connected.",true); return
    end
    lastSend=os.clock()
    local payload={
        uid=tostring(LocalPlayer.UserId), dn=LocalPlayer.DisplayName, un=LocalPlayer.Name,
        pfp=1, txt=text, ts={[".sv"]="timestamp"},
    }
    inputBox.Text=""
    -- Optimistic local render so the UI responds immediately.
    addMessage("local_"..tostring(os.clock()),{
        uid=tostring(LocalPlayer.UserId),dn=LocalPlayer.DisplayName,un=LocalPlayer.Name,
        txt=text,ts=os.time()*1000,
    })
    task.spawn(function()
        local ok,data,raw=dbRequest("POST",path,payload,auth,FIREBASE_DB)
        if ok then
            toast("Message sent")
        else
            toast("Firebase write failed: "..tostring(raw),true)
            warn("[SAIKI CHAT] Send failed: "..tostring(raw))
        end
    end)
end
_G.SaikiHubSend=sendMessage
sendButton.Activated:Connect(sendMessage)
inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and UserInputService:GetFocusedTextBox()==nil then sendMessage() end
end)

refreshMessages=function()
    local path=currentPath()
    if not path or not alive then return end
    local extra='orderBy="$key"&limitToLast='..MAX_CARDS
    local ok,data,raw=dbRequest("GET",path,nil,auth,FIREBASE_DB,extra)
    if not ok then
        if activePage=="Messages" then statusLabel.Text="OFFLINE"; statusLabel.TextColor3=C.red end
        warn("[SAIKI CHAT] Read failed: "..tostring(raw))
        return
    end
    if type(data)~="table" then return end
    local rows={}
    for key,msg in pairs(data) do
        if type(msg)=="table" then table.insert(rows,{key=key,msg=msg}) end
    end
    table.sort(rows,function(a,b) return tostring(a.key)<tostring(b.key) end)
    for _,item in ipairs(rows) do addMessage(item.key,item.msg) end
end

