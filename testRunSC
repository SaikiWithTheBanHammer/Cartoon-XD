function toggleMyReaction(messageKey, reaction)
    if not Auth.idToken or not Auth.uid or not messageKey or not reaction then return false end

    local uid = tostring(Auth.uid)
    local current = reactionState[messageKey] and reactionState[messageKey][uid]
    local endpoint = "/servers/" .. urlEncode(game.JobId) .. "/reactions/" .. urlEncode(messageKey) .. "/" .. urlEncode(Auth.uid)

    if current == reaction then
        local ok = requestJSON("DELETE", authURL(endpoint, Auth.idToken))
        if ok then
            reactionState[messageKey] = reactionState[messageKey] or {}
            reactionState[messageKey][uid] = nil
            local card = cardByKey[messageKey]
            if card then updateReactionBadges(card) end
            return true
        end
        return false
    end

    local ok = requestJSON("PUT", authURL(endpoint, Auth.idToken), reaction)
    if ok then
        setLocalReaction(messageKey, reaction)
        return true
    end
    return false
end

