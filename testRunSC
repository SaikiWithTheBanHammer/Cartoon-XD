-- v1.10: keep v1.9's floating flyout design, but smoothly dismiss an open
-- flyout when the user clicks/taps the conversation or focuses the composer.
-- Clicking inside either flyout itself must NOT dismiss it before its button works.
local function pointInside(guiObject, point)
    if not guiObject or not guiObject.Visible then return false end
    local pos, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X
        and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end
local function collapseChatFlyouts()
    local changed = serverExpanded or dmExpanded
    serverExpanded, dmExpanded = false, false
    if changed then updateSelectorPanels() end
end
