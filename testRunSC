    corner(b, 12)
    b.MouseEnter:Connect(function()
        if b.Parent then TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=C.raised}):Play() end
    end)
    b.MouseLeave:Connect(function()
        if b.Parent then TweenService:Create(b,TweenInfo.new(.12),{BackgroundColor3=color or C.card}):Play() end
    end)
    b.Activated:Connect(function()
        if callback then callback() end
    end)
    return b
end
