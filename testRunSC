local function emojiCodepoints(value)
    local out = {}
    local ok = pcall(function()
        for _, codepoint in utf8.codes(value) do
            table.insert(out, string.format("%x", codepoint))
        end
    end)
    return ok and table.concat(out, "-") or nil
end

local function cacheReactionAsset(reaction)
    if not (writefile and isfile and getcustomasset) then return nil end
    local codepoints = emojiCodepoints(reaction)
    if not codepoints then return nil end

    local path = EMOJI_CACHE_FOLDER .. "/" .. codepoints .. ".png"
    if not isfile(path) then
        local url = "https://cdn.jsdelivr.net/gh/jdecked/twemoji@17.0.3/assets/72x72/" .. codepoints .. ".png"
        local ok, data = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(data) == "string" and #data > 0 then
            pcall(writefile, path, data)
        end
    end

    if isfile(path) then
        local ok, asset = pcall(getcustomasset, path)
        if ok then return asset end
    end
    return nil
end


