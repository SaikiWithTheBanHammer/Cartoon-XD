local function dmThreadId(a, b)
    a, b = tostring(a), tostring(b)
    if tonumber(a) and tonumber(b) then
        if tonumber(a) > tonumber(b) then a, b = b, a end
    elseif a > b then
        a, b = b, a
    end
    return a .. "_" .. b
end

local DM_HISTORY_PATH = CACHE_FOLDER .. "/dm_history.json"

local function loadDMHistory()
    dmHistory = {}
    if not (readfile and isfile) then return end
    if not isfile(DM_HISTORY_PATH) then return end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(DM_HISTORY_PATH)) end)
    if ok and type(decoded) == "table" then
        for _, entry in ipairs(decoded) do
            if type(entry) == "table" and tonumber(entry.Id) and tonumber(entry.Id) ~= LocalPlayer.UserId then
                if entry.HasMessage == true then
                    table.insert(dmHistory, {
                        Id = tonumber(entry.Id),
                        Username = tostring(entry.Username or ""),
                        DisplayName = tostring(entry.DisplayName or entry.Username or "Unknown"),
                        LastAt = tonumber(entry.LastAt) or 0,
                        HasMessage = true,
                        HasIncoming = entry.HasIncoming == true,
                    })
                end
            end
        end
    end
end

local function saveDMHistory()
    if not (writefile and makefolder) then return end
    pcall(makefolder, CACHE_FOLDER)
    pcall(writefile, DM_HISTORY_PATH, HttpService:JSONEncode(dmHistory))
end

local function rememberDMUser(user, incoming, lastAt)
    if not user or tonumber(user.Id) == tonumber(LocalPlayer.UserId) then return end
    local id = tonumber(user.Id)
    local existing = nil
    for _, entry in ipairs(dmHistory) do
        if tonumber(entry.Id) == id then
            existing = entry
            break
        end
    end

    local updated = {
        Id = id,
        Username = tostring(user.Username or (existing and existing.Username) or ""),
        DisplayName = tostring(user.DisplayName or (existing and existing.DisplayName) or user.Username or "Unknown"),
        LastAt = tonumber(lastAt) or DateTime.now().UnixTimestampMillis,
        HasMessage = true,
        HasIncoming = (incoming == true) or (existing and existing.HasIncoming == true) or false,
    }

    local out = {updated}
    for _, entry in ipairs(dmHistory) do
        if tonumber(entry.Id) ~= id then table.insert(out, entry) end
        if #out >= 40 then break end
    end
    dmHistory = out
    saveDMHistory()
end

-- Scan the DM database for messages that were sent TO this player. This is
-- intentionally independent of which DM conversations the player has opened.
-- The local history then survives later database cleanup.
local function syncDMIncomingHistory()
    if not DMAuth.idToken then return end
    local ok, data = requestJSON("GET", dmAuthURL("/dmThreads", DMAuth.idToken))
    if not ok or type(data) ~= "table" then return end

    local myId = tostring(LocalPlayer.UserId)
    local found = {}
    for _, thread in pairs(data) do
        if type(thread) == "table" and type(thread.messages) == "table" then
            for _, msg in pairs(thread.messages) do
                if type(msg) == "table"
                    and tostring(msg.recipientId or "") == myId
                    and tostring(msg.senderId or "") ~= myId then
                    local senderId = tonumber(msg.senderId)
                    if senderId then
                        local old = found[senderId]
                        local stamp = tonumber(msg.timestamp) or 0
                        if not old or stamp >= old.LastAt then
                            found[senderId] = {
                                Id = senderId,
                                Username = tostring(msg.senderUsername or ""),
                                DisplayName = tostring(msg.senderDisplayName or msg.senderUsername or "Unknown"),
                                LastAt = stamp,
                            }
                        end
                    end
                end
            end
        end
    end

    local changed = false
    for _, sender in pairs(found) do
        rememberDMUser(sender, true, sender.LastAt)
        changed = true
    end

    if changed then
        table.sort(dmHistory, function(a, b)
            return (tonumber(a.LastAt) or 0) > (tonumber(b.LastAt) or 0)
        end)
        while #dmHistory > 40 do table.remove(dmHistory) end
        saveDMHistory()
        if activeTab == "dm" and not activeDMUser then
            renderDMResults()
        end
    end
end

