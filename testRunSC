function updateReactionBadges(card)
    if not card or not card.ReactionFrame then return end
    for _, child in ipairs(card.ReactionFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("ImageButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local reactions = reactionState[card.Key]
    local counts = {}
    local total = 0
    if type(reactions) == "table" then
        for _, emoji in pairs(reactions) do
            if type(emoji) == "string" and emoji ~= "" then
                counts[emoji] = (counts[emoji] or 0) + 1
                total += 1
            end
        end
    end

    if total == 0 then
        card.ReactionFrame.Visible = false
        card.ReactionFrame.Size = UDim2.fromOffset(0, 0)
        card.Gui.Size = UDim2.new(1, 0, 0, card.Message._baseHeight or 34)
        return
    end

    local order = {}
    for emoji in pairs(counts) do table.insert(order, emoji) end
    table.sort(order)

    local width = math.min(145, 24 * #order)
    card.Gui.Size = UDim2.new(1, 0, 0, (card.Message._baseHeight or 34) + 21)
    card.ReactionFrame.Visible = true
    card.ReactionFrame.Size = UDim2.fromOffset(width, 20)
    card.ReactionFrame.Position = UDim2.fromOffset(
        card.GroupLeft + (card.Mine and math.max(0, card.BubbleWidth - width) or card.AvatarSize + card.GroupGap),
        card.BubbleHeight + 1
    )

    for i, emoji in ipairs(order) do
        local count = counts[emoji]
        local pillWidth = count > 1 and 34 or 22
        local pill = new("Frame", {
            BackgroundColor3 = Color3.fromRGB(27, 27, 30),
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(pillWidth, 18),
            Position = UDim2.fromOffset((i - 1) * 24, 1),
            ZIndex = 21,
        }, card.ReactionFrame)
        addCorner(pill, 8)

        local reactionButton = new("TextButton", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(pillWidth, 18),
            Position = UDim2.fromOffset(0, 0),
            AutoButtonColor = false,
            Text = "",
            ZIndex = 22,
        }, pill)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(14, 18),
            Position = UDim2.fromOffset(1, 0),
            Font = Enum.Font.Gotham,
            Text = emoji,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 23,
        }, reactionButton)

        if count > 1 then
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(15, 0),
                Size = UDim2.fromOffset(17, 18),
                Font = Enum.Font.GothamBold,
                Text = tostring(count),
                TextColor3 = Color3.fromRGB(170, 170, 175),
                TextSize = 8,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 23,
            }, reactionButton)
        end

        -- Tapping a reaction badge that belongs to the current user removes it.
        reactionButton.MouseButton1Click:Connect(function()
            if not Auth.idToken or not Auth.uid then return end
            local uid = tostring(Auth.uid)
            if reactionState[card.Key] and reactionState[card.Key][uid] == emoji then
                -- Tapping your own reaction badge removes that reaction for everyone.
                toggleMyReaction(card.Key, emoji)
            end
        end)
    end
end

renderMessage = function(message)
    if not message or not message.key or cardByKey[message.key] then return end

    while #cards >= MAX_CARDS do
        local oldest = table.remove(cards, 1)
        removeCard(oldest)
    end

    layoutCounter += 1

    -- Treat a message as ours if either Firebase UID OR Roblox UserId matches.
    local isUltron = message._ultron == true
        or tostring(message.senderType or "") == "ultron"
        or tostring(message.displayName or "") == ULTRON_NAME

    local mine = not isUltron and (
        tostring(message.uid) == tostring(Auth.uid)
        or tonumber(message.robloxUserId) == tonumber(LocalPlayer.UserId)
    )

    local isSticker = tostring(message.type or "text") == "sticker"
    local bodyText = tostring(message.message or (isSticker and "Sticker") or "")
    local displayName = isUltron and ULTRON_NAME or tostring(message.displayName or message.username or "Unknown")

    -------------------------------------------------------------------------
    -- Text sizing
    --
    -- Measure the unwrapped line first, then measure it again using the
    -- ACTUAL bubble width. This prevents long messages from getting a
    -- rectangular-looking bubble with text that wraps outside the calculated
    -- height.
    -------------------------------------------------------------------------
    local textSize = 11
    local font = Enum.Font.GothamBold
    local maxBodyWidth = 205
    local minBodyWidth = 46

    local bodyWidth, bodyHeight
    if isSticker then
        bodyWidth = 118
        bodyHeight = 118
    else
        local unwrapped = TextService:GetTextSize(
            bodyText, textSize, font, Vector2.new(10000, 1000)
        )
        bodyWidth = math.clamp(unwrapped.X, minBodyWidth, maxBodyWidth)
        local wrapped = TextService:GetTextSize(
            bodyText, textSize, font, Vector2.new(bodyWidth, 10000)
        )
        local lineHeight = 13
        -- Give the TextLabel extra vertical room. Roblox can round the measured
        -- wrapped height down, which can clip the final word/line of a message.
        bodyHeight = math.max(lineHeight, math.ceil(wrapped.Y) + 12)
    end

    -- Reply target. Prefer the rendered target; if it has already scrolled
    -- out of the 50-card window, use the stored reply metadata if available.
    local replyPreview = nil
    if message.replyTo then
        local targetCard = cardByKey[message.replyTo]
        if targetCard and targetCard.Message then
            replyPreview = targetCard.Message
        else
            replyPreview = {
                displayName = "Previous message",
                message = "Message"
            }
        end
    end

    -- Only other users get a sender name. Your own messages stay clean.
    local showName = not mine

    -- Keep bubbles content-sized. Long messages become wider + taller;
    -- short messages remain small pills.
    local bubbleWidth = isSticker and 132 or math.clamp(bodyWidth + 20, 66, 225)

    local nameHeight = showName and 12 or 0
    local replyHeight = replyPreview and 32 or 0
    local topPad = showName and 3 or 0
    local bodyTop = topPad + nameHeight + (replyPreview and 3 or 2) + replyHeight
    local bubbleHeight = math.max(
        28,
        math.ceil(bodyTop + bodyHeight + 6)
    )

    local reactionExtra = 0
    local holderHeight = bubbleHeight + reactionExtra + 3

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, holderHeight),
        LayoutOrder = layoutCounter,
    }, Scroll)

    local avatarSize = 25
    -- WhatsApp-style alignment: other users stay on the LEFT, our messages
    -- stay on the RIGHT. The text inside each bubble remains centered separately.
    local groupGap = 7
    local groupWidth = bubbleWidth + avatarSize + groupGap
    local viewportWidth = math.max(0, Scroll.AbsoluteSize.X)
    local edgePadding = 5
    local groupLeft
    if mine then
        groupLeft = math.max(0, viewportWidth - groupWidth - edgePadding)
    else
        groupLeft = edgePadding
    end

    local avatar = new("ImageLabel", {
        BackgroundColor3 = Color3.fromRGB(19, 19, 21),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(avatarSize, avatarSize),
        Position = UDim2.fromOffset(
            mine and groupLeft + bubbleWidth + groupGap or groupLeft,
            math.max(1, math.floor((bubbleHeight - avatarSize) / 2))
        ),
        Image = isUltron and tostring(message._ultronAsset or ULTRON_ASSET or "") or getAvatar(message.robloxUserId),
        ScaleType = Enum.ScaleType.Crop,
        ClipsDescendants = true,
    }, holder)
    addCorner(avatar, math.floor(avatarSize / 2))

    -- Ultron join messages use the exact same incoming-message bubble
    -- geometry and color as every other message received from another user.
    -- Only the sender identity/avatar remains Ultron.
    local bubble = new("Frame", {
        BackgroundColor3 = mine and Color3.fromRGB(31, 31, 34) or Color3.fromRGB(20, 20, 22),
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(
            mine and groupLeft or groupLeft + avatarSize + groupGap,
            0
        ),
        Size = UDim2.fromOffset(bubbleWidth, bubbleHeight),
    }, holder)

    -- All received messages, including Saiki's Ultron announcements,
    -- use the same content-sized bubble geometry:
    -- short messages are pills and taller messages use the same rounded
    -- rectangle radius as other incoming messages.
    local bubbleRadius = bubbleHeight <= 34 and math.floor(bubbleHeight / 2) or 12
    addCorner(bubble, bubbleRadius)

    local contentY = 4

    if showName then
        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 3),
            Size = UDim2.new(1, -20, 0, 9),
            Font = Enum.Font.GothamBold,
            Text = displayName,
            TextColor3 = isUltron and Color3.fromRGB(255, 255, 255) or getDisplayNameColor(displayName),
            TextSize = 8,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, bubble)
        contentY = 14
    end

    if replyPreview then
        local quote = new("Frame", {
            BackgroundColor3 = Color3.fromRGB(27, 27, 30),
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(8, contentY),
            Size = UDim2.new(1, -16, 0, 32),
        }, bubble)
        addCorner(quote, 9)

        new("Frame", {
            BackgroundColor3 = Color3.fromRGB(45, 160, 232),
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 5),
            Size = UDim2.new(0, 2, 1, -10),
        }, quote)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 3),
            Size = UDim2.new(1, -14, 0, 10),
            Font = Enum.Font.GothamBold,
            Text = tostring(replyPreview.displayName or "User"),
            TextColor3 = Color3.fromRGB(55, 161, 228),
            TextSize = 8,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, quote)

        new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 14),
            Size = UDim2.new(1, -14, 0, 14),
            Font = Enum.Font.GothamBold,
            Text = tostring(replyPreview.message or "Message"),
            TextColor3 = Color3.fromRGB(190, 190, 195),
            TextSize = 9,
            TextWrapped = false,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, quote)

        contentY = contentY + 35
    end

    if isSticker then
        local stickerImage = new("ImageLabel", {
            BackgroundTransparency=1, Position=UDim2.fromOffset(7, contentY),
            Size=UDim2.new(1,-14,0,bodyHeight), Image=tostring(message._stickerAsset or ""),
            ScaleType=Enum.ScaleType.Fit, ZIndex=2
        }, bubble)

        -- Firebase stores the public GitHub URL, not the sender's local
        -- executor asset path. Receivers cache that URL locally before
        -- assigning it to ImageLabel.Image.
        if not message._stickerAsset and message.sticker then
            task.spawn(function()
                local asset = cacheRemoteSticker(tostring(message.sticker))
                if asset and stickerImage and stickerImage.Parent then
                    stickerImage.Image = asset
                end
            end)
        end
    else
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(10, contentY + (mine and 3 or 0)),
            Size = UDim2.new(1, -20, 0, bodyHeight), Font = font, Text = bodyText,
            TextColor3 = isUltron and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(232, 232, 235), TextSize = textSize, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
            TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top,
        }, bubble)
    end

    local hitbox = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 5,
    }, bubble)

    local reactionFrame = new("Frame", {
        Visible = false,
        BackgroundTransparency = 1,
        ZIndex = 20,
        Position = UDim2.fromOffset(
            mine and (groupLeft + math.max(0, bubbleWidth - 145))
                or (groupLeft + avatarSize + groupGap),
            bubbleHeight + 1
        ),
        Size = UDim2.fromOffset(0, 0),
    }, holder)

    local card = {
        Key = message.key,
        Gui = holder,
        Message = message,
        ReactionFrame = reactionFrame,
        GroupLeft = groupLeft,
        BubbleWidth = bubbleWidth,
        BubbleHeight = bubbleHeight,
        AvatarSize = avatarSize,
        GroupGap = groupGap,
        Mine = mine,
    }
    card.Message._baseHeight = bubbleHeight + 3

    -- Long press only opens the centered action popup.
    local pressStart = 0
    local holdTriggered = false
    local activeInput = nil

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        activeInput = input
        pressStart = os.clock()
        holdTriggered = false

        task.delay(0.42, function()
            if activeInput == input
                and not holdTriggered
                and os.clock() - pressStart >= 0.40 then
                holdTriggered = true
                openMessagePopup(message)
            end
        end)
    end)

    hitbox.InputEnded:Connect(function(input)
        if input == activeInput then
            activeInput = nil
        end
    end)

    table.insert(cards, card)
    cardByKey[message.key] = card
    updateReactionBadges(card)

    task.defer(function()
        if holder.Parent then
            Scroll.CanvasPosition = Vector2.new(
                0,
                math.max(0, Scroll.AbsoluteCanvasSize.Y)
            )
        end
    end)
end

-- -----------------------------------------------------------------------------
-- Server chat
-- -----------------------------------------------------------------------------
cutoffKey = nil
seen = {}

local function getLatestKey()
    local ok, data = requestJSON(
        "GET",
        authURL(
            "/servers/" .. urlEncode(game.JobId) .. "/messages",
            Auth.idToken,
            'orderBy="$key"&limitToLast=1'
        )
    )
    if not ok or type(data) ~= "table" then return nil end
    for key in pairs(data) do return key end
    return nil
end

local function getNewMessages()
    local extra = 'orderBy="$key"&limitToLast=60'
    if cutoffKey then
        extra = 'orderBy="$key"&startAt="' .. urlEncode(cutoffKey) .. '"&limitToFirst=60'
    end

    local ok, data = requestJSON(
        "GET",
        authURL("/servers/" .. urlEncode(game.JobId) .. "/messages", Auth.idToken, extra)
    )
    if not ok or type(data) ~= "table" then return end

    local list = {}
    for key, msg in pairs(data) do
        if type(msg) == "table" then
            msg.key = key
            table.insert(list, msg)
        end
    end

    table.sort(list, function(a, b)
        return tostring(a.key) < tostring(b.key)
    end)

    for _, msg in ipairs(list) do
        -- startAt is inclusive in Firebase REST, so explicitly discard the
        -- snapshot key itself. This prevents the last pre-join message from
        -- appearing as if it was sent by someone after we joined.
        if (not cutoffKey or tostring(msg.key) > tostring(cutoffKey)) and not seen[msg.key] then
            seen[msg.key] = true
            renderMessage(msg)
            cutoffKey = msg.key
        end
    end
end

showSlowMode = function(seconds)
    Input.PlaceholderText = string.format("Wait %.1fs...", seconds)
    tween(Composer, {BackgroundColor3 = Color3.fromRGB(24, 15, 16)}, 0.12)
    task.delay(math.min(seconds, 1), function()
        if Composer.Parent then
            Input.PlaceholderText = "Type message..."
            tween(Composer, {BackgroundColor3 = Color3.fromRGB(13, 13, 15)}, 0.18)
        end
    end)
end

local ULTRON_JOIN_PHRASES = {
    "%s Just Crashed into Chat",
    "%s Just Landed, everyone Say Hi!",
    "YOOOOOOOO %s WB yawrr!!!",
    "%s Just Pulled Up — Make Some Noise!",
    "%s Has Entered the Server — W Chat!",
    "%s Touchdown! Welcome to the chaos!",
}

local function sendUltronJoinMessage()
    if not Auth.idToken or not Auth.uid then return end

    local template = ULTRON_JOIN_PHRASES[math.random(1, #ULTRON_JOIN_PHRASES)]
    local joinText = string.format(template, tostring(LocalPlayer.DisplayName))
    local now = DateTime.now().UnixTimestampMillis

    -- This is an app-level Ultron identity inside Saiki Rechat. It is stored
    -- through the current anonymous Firebase client, then every Rechat client
    -- renders it as Saiki's Ultron instead of as the joining player.
    local message = {
        uid = Auth.uid,
        robloxUserId = 0,
        username = ULTRON_NAME,
        displayName = ULTRON_NAME,
        type = "text",
        message = joinText,
        timestamp = now,
        _ultron = true,
        _ultronAsset = ULTRON_ASSET,
    }

    local optimisticKey = "local_ultron_" .. tostring(now) .. "_" .. tostring(math.random(100000, 999999))
    message.key = optimisticKey
    message._optimistic = true
    seen[optimisticKey] = true
    renderMessage(message)

    local payload = {
        uid = message.uid,
        robloxUserId = 0,
        username = ULTRON_NAME,
        displayName = ULTRON_NAME,
        type = "text",
        message = joinText,
        timestamp = now,
    }

    task.spawn(function()
        local ok, result = requestJSON(
            "POST",
            authURL("/servers/" .. urlEncode(game.JobId) .. "/messages", Auth.idToken),
            payload
        )

        if ok then
            local realKey = type(result) == "table" and result.name or nil
            local card = cardByKey[optimisticKey]
            if realKey and card then
                cardByKey[optimisticKey] = nil
                card.Key = realKey
                card.Message.key = realKey
                card.Message._optimistic = nil
                cardByKey[realKey] = card
                seen[realKey] = true
            elseif realKey then
                seen[realKey] = true
            end
        else
            local card = cardByKey[optimisticKey]
            if card then
                removeCard(card)
                for i = #cards, 1, -1 do
                    if cards[i] == card then
                        table.remove(cards, i)
                        break
                    end
                end
            end
        end
    end)
end

local function sendMessage()
    -- Preserve the textbox contents exactly. Only use a trimmed copy to decide
    -- whether the message is effectively empty; never trim or truncate what is sent.
    local textValue = tostring(Input.Text or "")
    if textValue:gsub("%s+", "") == "" then return end

    local elapsed = os.clock() - lastSentAt
    if elapsed < SLOW_MODE then
        showSlowMode(SLOW_MODE - elapsed)
        return
    end

    lastSentAt = os.clock()

    local message = {
        uid = Auth.uid,
        robloxUserId = profile.robloxUserId,
        username = profile.username,
        displayName = profile.displayName,
        type = "text",
        message = textValue,
        timestamp = DateTime.now().UnixTimestampMillis,
    }
    if replyKey then
        message.replyTo = replyKey
    end

    -- Render locally FIRST. The sender never waits for Firebase/polling to see their own message.
    local optimisticKey = "local_" .. tostring(message.timestamp) .. "_" .. tostring(math.random(100000, 999999))
    message.key = optimisticKey
    message._optimistic = true
    seen[optimisticKey] = true
    renderMessage(message)

    Input.Text = ""
    clearReply()

    -- Do not send client-only UI fields to Firebase.
    local payload = {
        uid = message.uid,
        robloxUserId = message.robloxUserId,
        username = message.username,
        displayName = message.displayName,
        type = message.type,
        message = message.message,
        timestamp = message.timestamp,
    }
    if message.replyTo then payload.replyTo = message.replyTo end

    task.spawn(function()
        local ok, result = requestJSON(
            "POST",
            authURL("/servers/" .. urlEncode(game.JobId) .. "/messages", Auth.idToken),
            payload
        )

        if ok then
            local realKey = type(result) == "table" and result.name or nil
            local card = cardByKey[optimisticKey]

            if realKey and card then
                cardByKey[optimisticKey] = nil
                card.Key = realKey
                card.Message.key = realKey
                card.Message._optimistic = nil
                cardByKey[realKey] = card
                seen[realKey] = true
            elseif realKey then
                seen[realKey] = true
            end
        else
            -- The optimistic card is removed only if the actual write fails.
            local card = cardByKey[optimisticKey]
            if card then
                removeCard(card)
                for i = #cards, 1, -1 do
                    if cards[i] == card then
                        table.remove(cards, i)
                        break
                    end
                end
            end
            lastSentAt = -math.huge
            Input.PlaceholderText = "Send failed"
            tween(Composer, {BackgroundColor3 = Color3.fromRGB(28, 14, 15)}, 0.12)
            task.delay(1, function()
                if Composer.Parent then
                    Input.PlaceholderText = "Type message..."
                    tween(Composer, {BackgroundColor3 = Color3.fromRGB(13, 13, 15)}, 0.18)
                end
            end)
        end
    end)
end
Send.MouseButton1Click:Connect(sendMessage)
Input.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessage() end
end)

-- Do not enforce a client-side character limit here. Roblox/Firebase can store
-- the full TextBox value, and changing Input.Text while the user is typing was
-- the cause of the tail of longer messages being silently discarded.

-- Snapshot the newest existing message. Nothing before this point is rendered.
cutoffKey = getLatestKey()

-- Announce this client entering the current JobId server after the pre-join
-- snapshot is taken, so the join message itself is treated as new.
task.delay(0.35, sendUltronJoinMessage)

-- Poll only for messages created after joining.
task.spawn(function()
    local reactionTick = 0
    while ScreenGui.Parent do
        task.wait(POLL_RATE)
        reactionTick += 1

        if not Auth.idToken then
            refreshAuthToken()
        end

        if Auth.idToken then
            getNewMessages()

            -- One small reaction-tree request every ~4.5 seconds instead of
            -- one request per message. Message cards themselves are never rebuilt.
            if reactionTick % 2 == 0 then
                refreshAllReactions()
            end
        end
    end
end)

