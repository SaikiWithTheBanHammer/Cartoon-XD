local function refreshRankings()
    for _,child in ipairs(rankScroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    rankStatus.Text="Ranked by follower count • loading…"
    task.spawn(function()
        local ok,data=dbRequest("GET","/profiles.json",nil,auth,FIREBASE_DB)
        if not ok or type(data)~="table" then
            rankStatus.Text="Could not load rankings. Check Firebase read rules and tap REFRESH."
            return
        end
        local entries={}
        for uid,profile in pairs(data) do
            if type(profile)=="table" then
                local followers=tonumber(profile.followers) or 0
                table.insert(entries,{uid=tostring(uid),dn=tostring(profile.dn or profile.displayName or "Player"),un=tostring(profile.un or ""),followers=followers})
            end
        end
        table.sort(entries,function(a,b)
            if a.followers==b.followers then return string.lower(a.dn)<string.lower(b.dn) end
            return a.followers>b.followers
        end)
        if #entries==0 then rankStatus.Text="No public profiles found yet."; return end
        rankStatus.Text=tostring(#entries).." profiles • sorted by followers (highest first)"
        for i,entry in ipairs(entries) do
