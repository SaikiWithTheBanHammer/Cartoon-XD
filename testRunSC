-- Reaction data helpers. Reactions are stored as one emoji per Firebase UID,
-- so each user can change their reaction without creating duplicates.
local function setLocalReaction(messageKey, reaction)
    reactionState[messageKey] = reactionState[messageKey] or {}
    reactionState[messageKey][tostring(Auth.uid)] = reaction

    local card = cardByKey[messageKey]
    if card then
        updateReactionBadges(card)
    end
end

function fetchReactionsForMessage(messageKey)
    if not Auth.idToken or not messageKey then return false end

    local ok, data = requestJSON(
        "GET",
        authURL(
            "/servers/" .. urlEncode(game.JobId) .. "/reactions/" .. urlEncode(messageKey),
            Auth.idToken
        )
    )

    if not ok then return false end

    local state = {}
    if type(data) == "table" then
        for uid, emoji in pairs(data) do
            if type(uid) == "string" and type(emoji) == "string" and emoji ~= "" then
                state[uid] = emoji
            end
        end
    end

    reactionState[messageKey] = state
    local card = cardByKey[messageKey]
    if card then
        updateReactionBadges(card)
    end
    return true
end

local function refreshAllReactions()
    if not Auth.idToken then return end

    -- Only refresh cards currently near the visible viewport. This keeps the
    -- reaction sync live without generating dozens of HTTP requests every tick.
    local top = Scroll.AbsolutePosition.Y
    local bottom = top + Scroll.AbsoluteWindowSize.Y

    for _, card in ipairs(cards) do
        if card and card.Gui and card.Gui.Parent then
            local y = card.Gui.AbsolutePosition.Y
            local h = card.Gui.AbsoluteSize.Y
            if y + h >= top - 80 and y <= bottom + 80 then
                task.spawn(function()
                    fetchReactionsForMessage(card.Key)
                end)
            end
        end
    end
end

