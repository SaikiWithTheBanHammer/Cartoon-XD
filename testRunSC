local function tweenFlyout(panel, open, targetWidth)
    if selectorTweens[panel] then selectorTweens[panel]:Cancel(); selectorTweens[panel]=nil end
    if open then
        local wasVisible=panel.Visible
        panel.Visible=true
        panel.ClipsDescendants=true
        if not wasVisible then panel.Size=UDim2.new(0,0,1,0) end
        local tween=TweenService:Create(panel,TweenInfo.new(.24,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Size=UDim2.new(0,targetWidth,1,0)})
        selectorTweens[panel]=tween
        tween.Completed:Connect(function() if selectorTweens[panel]==tween then selectorTweens[panel]=nil end end)
        tween:Play()
    elseif panel.Visible then
        local tween=TweenService:Create(panel,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{Size=UDim2.new(0,0,1,0)})
        selectorTweens[panel]=tween
