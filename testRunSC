local function requestJSON(method, url, body, extraHeaders)
    local opts = {
        Url = url, Method = method,
        Headers = {["Content-Type"]="application/json"},
    }
    if extraHeaders then
        for k,v in pairs(extraHeaders) do opts.Headers[k] = v end
    end
    if body ~= nil then opts.Body = HttpService:JSONEncode(body) end
    local ok, res = pcall(REQUEST, opts)
    if not ok or not res then return false, nil, tostring(res) end
    local code = tonumber(res.StatusCode or res.Status or 0) or 0
    local raw = res.Body or res.body or ""
    local decoded
    if raw ~= "" then pcall(function() decoded = HttpService:JSONDecode(raw) end) end
    return code >= 200 and code < 300, decoded, raw, code
end

local function enc(v) return HttpService:UrlEncode(tostring(v)) end
local function dbURL(base, path, token, extra)
    local url = base .. path .. ".json"
    local query = {}
    if token and token ~= "" then table.insert(query, "auth=" .. enc(token)) end
    if extra and extra ~= "" then table.insert(query, extra) end
    if #query > 0 then url = url .. "?" .. table.concat(query, "&") end
    return url
end

local function firebaseAuth(target)
    local key = target == dmAuth and DM_FIREBASE_API_KEY or FIREBASE_API_KEY
    local ok, data, raw = requestJSON("POST",
        "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. key,
        {returnSecureToken=true})
    if ok and type(data) == "table" and data.idToken then
        target.token, target.refresh, target.uid = data.idToken, data.refreshToken, data.localId
        return true
    end
    warn("[SAIKI CHAT] Firebase anonymous auth failed: " .. tostring(raw))
    return false
end

local function refreshFirebaseAuth(target)
    if not target.refresh then return firebaseAuth(target) end
    local key = target == dmAuth and DM_FIREBASE_API_KEY or FIREBASE_API_KEY
    local ok, data = requestJSON("POST",
        "https://securetoken.googleapis.com/v1/token?key=" .. key,
        "grant_type=refresh_token&refresh_token=" .. enc(target.refresh),
        {["Content-Type"]="application/x-www-form-urlencoded"})
    -- Some executor request wrappers JSON-encode Body automatically; retry as raw form body.
    if not ok then
        local opts = {
            Url = "https://securetoken.googleapis.com/v1/token?key=" .. key,
            Method = "POST",
            Headers = {["Content-Type"]="application/x-www-form-urlencoded"},
            Body = "grant_type=refresh_token&refresh_token=" .. enc(target.refresh),
        }
        local good, res = pcall(REQUEST, opts)
        if good and res and (tonumber(res.StatusCode or res.Status or 0) or 0) == 200 then
            pcall(function() data = HttpService:JSONDecode(res.Body or res.body or "") end)
            ok = type(data) == "table" and data.id_token ~= nil
        end
    end
    if ok and type(data) == "table" then
        target.token = data.id_token or data.idToken or target.token
        target.refresh = data.refresh_token or data.refreshToken or target.refresh
        target.uid = data.user_id or data.localId or target.uid
        return true
    end
    return firebaseAuth(target)
end

local function dbRequest(method, path, body, target, base, extra)
    target = target or auth
    base = base or FIREBASE_DB
    if not target.token then
        if not firebaseAuth(target) then return false, nil, "Firebase auth unavailable" end
    end
    local ok, data, raw, code = requestJSON(method, dbURL(base, path, target.token, extra), body)
    if code == 401 then
        if refreshFirebaseAuth(target) then
            ok, data, raw, code = requestJSON(method, dbURL(base, path, target.token, extra), body)
        end
    end
    return ok, data, raw, code
end

-- ===== Optional persistent asset cache =====
local function ensureFolder(path)
    if not makefolder then return end
    local current = ""
    for part in string.gmatch(path, "[^/]+") do
        current = current == "" and part or (current .. "/" .. part)
        if isfolder then
            if not isfolder(current) then pcall(makefolder, current) end
        else
            pcall(makefolder, current)
        end
    end
end
