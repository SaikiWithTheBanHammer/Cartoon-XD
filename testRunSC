local function requestJSON(method, url, body, contentType)
    local options = {
        Url = url,
        Method = method,
        Headers = { ["Content-Type"] = contentType or "application/json" },
    }
    if body ~= nil then
        options.Body = contentType == "application/x-www-form-urlencoded" and tostring(body) or HttpService:JSONEncode(body)
    end

    local ok, result = pcall(REQUEST, options)
    if not ok or not result then
        return false, nil, tostring(result)
    end

    local status = tonumber(result.StatusCode or result.Status or 0) or 0
    local raw = result.Body or result.body or ""
    local decoded
    if raw ~= "" then
        pcall(function() decoded = HttpService:JSONDecode(raw) end)
    end
    return status >= 200 and status < 300, decoded, raw
end

local function urlEncode(value)
    return HttpService:UrlEncode(tostring(value))
end

local function authURL(path, token, extra)
