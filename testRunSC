local function dmSearchScore(candidate, q)
    local name = string.lower(tostring(candidate.DisplayName or ""))
    local username = string.lower(tostring(candidate.Username or ""))
    if q == "" then return 0 end
    local score = -1
    if name == q or username == q then score = 1000
    elseif name:sub(1,#q) == q or username:sub(1,#q) == q then score = 800
    elseif string.find(name,q,1,true) or string.find(username,q,1,true) then score = 650
    else
        local words = {}
        for w in q:gmatch("%w+") do words[#words+1]=w end
        for _,w in ipairs(words) do
            if #w >= 2 and (string.find(name,w,1,true) or string.find(username,w,1,true)) then score = math.max(score, 420) end
        end
        -- Small typo tolerance: compare the query with display-name/username prefixes.
        local function distance(a,b)
            local la,lb=#a,#b
            if la>24 or lb>24 then return 99 end
            local prev={}
            for j=0,lb do prev[j]=j end
            for i=1,la do
                local cur={[0]=i}
                for j=1,lb do
                    local cost=(a:sub(i,i)==b:sub(j,j)) and 0 or 1
                    cur[j]=math.min(cur[j-1]+1,prev[j]+1,prev[j-1]+cost)
                end
                prev=cur
            end
            return prev[lb]
        end
        local d1=distance(q,name:sub(1,math.min(#name,math.max(#q,1))))
        local d2=distance(q,username:sub(1,math.min(#username,math.max(#q,1))))
        local d=math.min(d1,d2)
        if d <= math.max(1,math.floor(#q/4)) then score=260 end
    end
    return score
end

