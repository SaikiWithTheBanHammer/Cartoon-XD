local function pairFromDMKey(key, uid)
    local a,b=string.match(tostring(key),"^(%d+)_(%d+)$")
    if not a or not b then return nil end
    uid=tostring(uid or auth.uid or LocalPlayer.UserId)
    if a==uid then return b elseif b==uid then return a end
    return nil
end

local function getRecentPartnerInfo(uid)
    uid=tostring(uid or LocalPlayer.UserId)
    local ok,data=dbRequest("GET","/dm.json",nil,dmAuth,DM_FIREBASE_DB,"shallow=true")
    if not ok or type(data)~="table" then return nil,"Could not read recent DMs." end
    local candidates={}
    for pairKey,_ in pairs(data) do
        local partner=pairFromDMKey(pairKey,uid)
        if partner then table.insert(candidates,{pairKey=tostring(pairKey),partnerId=partner}) end
    end
    if #candidates==0 then return {},nil end
    local results={}
    -- Fetch only the latest message from each relevant conversation instead of
    -- downloading full DM histories. This keeps the Recent tab lightweight.
    for _,c in ipairs(candidates) do
        local ok2,msgs=dbRequest("GET","/dm/"..enc(c.pairKey)..".json",nil,dmAuth,DM_FIREBASE_DB,'orderBy="$key"&limitToLast=1')
        if ok2 and type(msgs)=="table" then
            local latestKey,latest
            for k,v in pairs(msgs) do latestKey=tostring(k); latest=v end
            if type(latest)=="table" and latest.ts then
                local sender=tostring(latest.uid or "")
                local otherId=sender==tostring(uid) and c.partnerId or sender
                if otherId==tostring(uid) or otherId=="" then otherId=c.partnerId end
                table.insert(results,{pairKey=c.pairKey,partnerId=otherId,latest=latest,key=latestKey})
            end
        end
    end
    table.sort(results,function(a,b) return (tonumber(a.latest.ts) or 0)>(tonumber(b.latest.ts) or 0) end)
    return results,nil
end

