    if not activeDMUser or not DMAuth.idToken then return end
    local thread = dmThreadId(LocalPlayer.UserId, activeDMUser.Id)
    local extra='orderBy="$key"&limitToLast=30'
    local ok, data = requestJSON("GET", dmAuthURL("/dmThreads/"..urlEncode(thread).."/messages", DMAuth.idToken, extra))
    if not ok and dmRefreshAuthToken() then
        ok, data = requestJSON("GET", dmAuthURL("/dmThreads/"..urlEncode(thread).."/messages", DMAuth.idToken, extra))
    end
    if not ok then return end
    local list={}
    for key,msg in pairs(data or {}) do
        if type(msg)=="table" then msg.key=key; table.insert(list,msg) end
    end
    table.sort(list,function(a,b) return tostring(a.key)<tostring(b.key) end)

    -- Opening an empty conversation must never create a History entry.
    -- Once at least one real message/sticker exists, persist this person locally.
    if #list > 0 then
        local hasIncoming = false
        local latestAt = 0
        for _, msg in ipairs(list) do
            local stamp = tonumber(msg.timestamp) or 0
            if stamp > latestAt then latestAt = stamp end
            if tostring(msg.recipientId or "") == tostring(LocalPlayer.UserId)
                and tostring(msg.senderId or "") ~= tostring(LocalPlayer.UserId) then
                hasIncoming = true
            end
        end
        rememberDMUser(activeDMUser, hasIncoming, latestAt)
    end

    for _,msg in ipairs(list) do renderDMMessage(msg) end

    -- A DM conversation always keeps only the newest 30 visible messages.
    -- This is count-based, not time-based: it does not matter whether they
    -- were sent seconds, days, or months ago.
    local visible = {}
    for _,child in ipairs(DMConversation:GetChildren()) do
        if child:IsA("Frame") and child ~= DMConversation:FindFirstChildOfClass("UIListLayout") then
            table.insert(visible, child)
        end
    end
    while #visible > 30 do
        local oldest = table.remove(visible, 1)
        local key = oldest:GetAttribute("DMMessageKey")
        if key then dmSeen[key] = nil end
        oldest:Destroy()
    end
end

ensureDMThread = function()
    if not activeDMUser then return false end
    if not DMAuth.idToken then
        if not dmSignIn() then return false end
    end
    if not saveDMIdentity() then
        if not dmRefreshAuthToken() or not saveDMIdentity() then return false end
    end
    local thread = dmThreadId(LocalPlayer.UserId, activeDMUser.Id)
    local a,b=tostring(LocalPlayer.UserId),tostring(activeDMUser.Id)
    if tonumber(a) and tonumber(b) and tonumber(a)>tonumber(b) then a,b=b,a end
    local meta={memberA=a,memberB=b,createdBy=tostring(LocalPlayer.UserId),updatedAt=DateTime.now().UnixTimestampMillis}
    local ok=requestJSON("PUT",dmAuthURL("/dmThreads/"..urlEncode(thread).."/meta",DMAuth.idToken),meta)
    if not ok and dmRefreshAuthToken() then
        ok=requestJSON("PUT",dmAuthURL("/dmThreads/"..urlEncode(thread).."/meta",DMAuth.idToken),meta)
    end
    return ok
end

sendDM = function(stickerUrl, stickerAsset)
    if activeTab ~= "dm" or not activeDMUser then return false end

    local isSticker = type(stickerUrl) == "string" and stickerUrl ~= ""
    local textValue = tostring(Input.Text or "")
    if not isSticker and textValue:gsub("%s+", "") == "" then
        return false
    end

    -- DM has its own send timer. Server-chat sends must never block a DM.
    local elapsed = os.clock() - (dmLastSentAt or -math.huge)
    if elapsed < SLOW_MODE then
        return false
    end

    -- Always obtain a usable DM Firebase session before attempting the write.
    if not DMAuth.uid then
        DMAuth.uid = tostring(LocalPlayer.UserId)
    end
    if not DMAuth.idToken then
        DMAuth.idToken = "public"
    end

    local thread = dmThreadId(LocalPlayer.UserId, activeDMUser.Id)
    local a, b = tostring(LocalPlayer.UserId), tostring(activeDMUser.Id)
    if tonumber(a) and tonumber(b) and tonumber(a) > tonumber(b) then a, b = b, a end

    -- Make/update the thread metadata first. This is deliberately independent
    -- of the server-chat Firebase database.
    local meta = {
        memberA = a,
        memberB = b,
        createdBy = tostring(LocalPlayer.UserId),
        updatedAt = DateTime.now().UnixTimestampMillis,
    }
    local metaOK, _, metaRaw = requestJSON(
        "PUT",
        dmAuthURL("/dmThreads/" .. urlEncode(thread) .. "/meta", DMAuth.idToken),
        meta
    )
    if not metaOK then
        if dmRefreshAuthToken() then
            metaOK, _, metaRaw = requestJSON(
                "PUT",
                dmAuthURL("/dmThreads/" .. urlEncode(thread) .. "/meta", DMAuth.idToken),
                meta
            )
        end
    end
    if not metaOK then
        dmSignIn()
        if DMAuth.idToken then
            metaOK, _, metaRaw = requestJSON(
                "PUT",
                dmAuthURL("/dmThreads/" .. urlEncode(thread) .. "/meta", DMAuth.idToken),
                meta
            )
        end
    end
    if not metaOK then
        Input.PlaceholderText = ""
        task.delay(2, function()
            if Composer.Parent and activeTab == "dm" and activeDMUser then
                Input.PlaceholderText = ""
            end
        end)
        return false
    end

    local now = DateTime.now().UnixTimestampMillis
    local message = {
        senderId = tostring(LocalPlayer.UserId),
        senderUsername = LocalPlayer.Name,
        senderDisplayName = LocalPlayer.DisplayName,
        recipientId = tostring(activeDMUser.Id),
        recipientUsername = tostring(activeDMUser.Username or ""),
        recipientDisplayName = tostring(activeDMUser.DisplayName or activeDMUser.Username or "Unknown"),
        type = isSticker and "sticker" or "text",
        message = isSticker and "Sticker" or textValue,
        timestamp = now,
    }
    if isSticker then
        message.sticker = stickerUrl
    end
    if replyKey then
        message.replyTo = replyKey
        message.replyToText = tostring(replyPreviewText or (isSticker and "Sticker" or "Message"))
        message.replyToDisplayName = tostring(replyDisplayName or "User")
    end

    -- PUT gives the message a deterministic client-generated key. This avoids
    -- depending on Firebase POST response parsing and makes retries idempotent.
    local messageId = tostring(now) .. "_" .. tostring(math.random(100000, 999999))
    local payload = {}
    for key, value in pairs(message) do
        if value ~= nil then payload[key] = value end
    end

    local messageURL = dmAuthURL(
        "/dmThreads/" .. urlEncode(thread) .. "/messages/" .. urlEncode(messageId),
        DMAuth.idToken
    )
    local ok, _, raw = requestJSON("PUT", messageURL, payload)
    if not ok and dmRefreshAuthToken() then
        ok, _, raw = requestJSON("PUT", dmAuthURL(
            "/dmThreads/" .. urlEncode(thread) .. "/messages/" .. urlEncode(messageId),
            DMAuth.idToken
        ), payload)
    end
    if not ok then
        dmSignIn()
        if DMAuth.idToken then
            ok, _, raw = requestJSON("PUT", dmAuthURL(
                "/dmThreads/" .. urlEncode(thread) .. "/messages/" .. urlEncode(messageId),
                DMAuth.idToken
            ), payload)
        end
    end

    if not ok then
        Input.PlaceholderText = ""
        task.delay(2, function()
            if Composer.Parent and activeTab == "dm" and activeDMUser then
                Input.PlaceholderText = ""
            end
        end)
        return false
    end

    dmLastSentAt = os.clock()
    rememberDMUser(activeDMUser)
    Input.Text = ""
    clearReply()
    StickerPanel.Visible = false

    -- Render only after Firebase accepted the write. This guarantees the card
    -- represents a real DM message instead of a local-only fake send.
    dmSeen = {}
    for _, child in ipairs(DMConversation:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
    loadDMMessages()
    return true
end

